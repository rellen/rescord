<.confirm id="example-remove-item" summary="Remove the item">
  <p>The item leaves the inventory. Its lots and its history stay.</p>
  <.button type="button" variant="danger">Remove Meadow hay</.button>
</.confirm>
<ul>
  <li id="example-feed-kitchen">
    Kitchen calendar
    <.confirm
      id="example-revoke-kitchen"
      summary="Revoke"
      label="Revoke the feed Kitchen calendar"
      icon="no-symbol"
    >
      <p>The calendar app that reads it gets nothing more.</p>
      <.button type="button" variant="danger">Revoke the feed Kitchen calendar</.button>
    </.confirm>
  </li>
</ul>
