<.input id="example-chronic" name="chronic" type="checkbox" label="The condition is chronic" />
<.input
  id="example-reminders"
  name="reminders"
  type="checkbox"
  label="Send me a reminder"
  hint="An email on the morning of the day."
/>
<.input
  id="example-agreed"
  name="agreed"
  type="checkbox"
  label="The owner agreed"
  errors={["must be ticked"]}
/>
