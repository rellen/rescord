<.input id="example-arrived" name="arrived" type="date" label="Arrived on" value="2026-11-21" />
<.input
  id="example-species"
  name="species"
  type="select"
  label="Species"
  prompt="Choose a species"
  options={["Guinea pig", "Rabbit"]}
  value="Rabbit"
/>
<.input id="example-note" name="note" type="textarea" label="Note" value="Eats well." />
