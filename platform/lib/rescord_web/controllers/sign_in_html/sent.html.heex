<Layouts.app flash={@flash} current_user={@current_user}>
  <.header icon="envelope">
    Look in your email
    <:subtitle>
      If Rescord knows this address, a link to sign in is on its way.
    </:subtitle>
  </.header>

  <p>The link works one time, for 15 minutes.</p>
  <p>
    No email? Look at the address and the spam folder, then <a href={~p"/sign-in"}>ask for another link</a>.
  </p>
</Layouts.app>
