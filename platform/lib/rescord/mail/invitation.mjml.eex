<mj-text css-class="rs-text"><h1 style="margin: 0; font-size: 24px; line-height: 32px; font-weight: 700;">You are invited to <%= @organisation %></h1></mj-text>
<mj-text css-class="rs-text"><%= @invited_by %> invited you to <%= @organisation %> on Rescord.</mj-text>
<mj-text css-class="rs-text">To sign in, open the sign-in page and type this email address: <strong><%= @to %></strong>. Rescord then sends you a link to sign in. You need no password.</mj-text>
<mj-button css-class="rs-button" href="<%= @url %>">Open the sign-in page</mj-button>
<mj-divider css-class="rs-rule" />
<mj-text css-class="rs-small" mj-class="small">If the button does not work, copy this address into your browser:<br /><a href="<%= @url %>" style="color: #1a5aa3; word-break: break-all;"><%= @url %></a></mj-text>
