# The settings of Rescord with Docker Compose (ADR 0044). Copy this file to
# .env, and fill in each value. docs/self-hosting.md explains each one.
# Make each secret with:  openssl rand -base64 48

# The image of Rescord: the version of a release, or `latest`.
RESCORD_IMAGE=ghcr.io/rellen/rescord:0.1.0

# The name of the host, as the people of the refuge type it.
PHX_HOST=rescord.example.org
# An email address for the certificate of Let's Encrypt, for a public name.
# "internal" for a server on a private network alone.
CADDY_TLS=you@example.org

# The password of the database, which only the containers use.
POSTGRES_PASSWORD=

# The secrets of the server: 64 bytes, 64 bytes and 32 bytes at least.
SECRET_KEY_BASE=
TOKEN_SIGNING_SECRET=
RESCORD_KEY_SECRET=

# The mail: an SMTP server that the refuge may use.
RESCORD_SMTP_HOST=smtp.example.org
RESCORD_SMTP_PORT=587
RESCORD_SMTP_TLS=starttls
RESCORD_SMTP_USERNAME=
RESCORD_SMTP_PASSWORD=
RESCORD_MAIL_FROM=rescord@example.org
RESCORD_MAIL_FROM_NAME=Rescord

# The files: "disk" keeps them in the volume "files". For a service that is
# compatible with S3, set "s3" and the five settings below.
RESCORD_STORAGE=disk
# RESCORD_S3_ENDPOINT=https://s3.example.org
# RESCORD_S3_REGION=auto
# RESCORD_S3_BUCKET=rescord
# path puts the bucket in the path; Tigris needs virtual, in the host.
# RESCORD_S3_ADDRESSING=path
# RESCORD_S3_ACCESS_KEY_ID=
# RESCORD_S3_SECRET_ACCESS_KEY=
