# The settings of Rescord from the tarball (ADR 0044). Copy this file to
# /etc/rescord/rescord.env, with mode 0600, and fill in each value.
# docs/self-hosting.md explains each one. Make each secret with:
#   openssl rand -base64 48

DATABASE_URL=ecto://rescord:PASSWORD@localhost/rescord
PHX_HOST=rescord.example.org

SECRET_KEY_BASE=
TOKEN_SIGNING_SECRET=
RESCORD_KEY_SECRET=

RESCORD_SMTP_HOST=smtp.example.org
RESCORD_SMTP_PORT=587
RESCORD_SMTP_TLS=starttls
RESCORD_SMTP_USERNAME=
RESCORD_SMTP_PASSWORD=
RESCORD_MAIL_FROM=rescord@example.org
RESCORD_MAIL_FROM_NAME=Rescord

# The unit keeps the files in /var/lib/rescord/files. For a service that is
# compatible with S3, set these, which win over the unit:
# RESCORD_STORAGE=s3
# RESCORD_S3_ENDPOINT=https://s3.example.org
# RESCORD_S3_REGION=auto
# RESCORD_S3_BUCKET=rescord
# RESCORD_S3_ACCESS_KEY_ID=
# RESCORD_S3_SECRET_ACCESS_KEY=
